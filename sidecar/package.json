{
  "name": "sidecar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node dist/sidecar.cjs",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/sidecar.cjs --external:@anthropic-ai/claude-agent-sdk",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --fix src",
    "lint:check": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
